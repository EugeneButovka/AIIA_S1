VM_HOST=<azure-vm-public-ip>
VM_USER=<ssh-user>
REPO_URL=<your-git-repo-url>
YOLO_API_URL=http://<azure-vm-public-ip>/predict

# SEND_MODE picks where captured frames go:
#   server      (default) POST to YOLO_API_URL on the VM — full local behaviour
#   azure       POST to the Azure Function /api/predict — same request/response
#               format, so boxes, local CSV and dashboard keep working
#   azure-blob  upload to the function's 'uploads' container — fire-and-forget,
#               results (CSV + annotated images) only in the cloud
#SEND_MODE=azure
#AZURE_PREDICT_URL=https://<default-domain>/api/predict  # Flex Consumption apps use a unique default domain, shown in the portal (e.g. <name>-<hash>.<region>.azurewebsites.net)
#SEND_MODE=azure-blob
#AZURE_STORAGE_CONNECTION_STRING=<function-app-storage-account-connection-string>
#AZURE_UPLOAD_CONTAINER=uploads